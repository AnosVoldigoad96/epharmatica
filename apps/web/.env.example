# ePharmatica — environment variables (PRD §17 Appendix A, initial set)
# Copy to .env.local for local dev. Real secrets live ONLY in the VPS compose
# env file (/opt/epharmatica-app/.env; docs/rules.md, securities.md) — never commit them.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin — used for absolute URLs, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Local dev values come from `supabase start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Imported in exactly one module: lib/supabase/admin.ts (invariant I2).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
# Used by migration tooling (Supabase CLI), not by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── AI key vault (Phase 1, M3) ──────────────────────────────────────────────
# Server-only libsodium sealed-box key for BYOK "sync" storage mode.
# Held only in server env — never in the database (PRD §7.4).
AI_KEYS_ENCRYPTION_KEY=replace-with-libsodium-key

# ── Email (Resend/Brevo SMTP — wired into GoTrue for transactional mail) ────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-pass
RESEND_API_KEY=replace-with-resend-key

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=replace-with-sentry-dsn
# CI-only: release tagging + sourcemap upload.
SENTRY_AUTH_TOKEN=replace-with-sentry-token
# Self-hosted Umami (cookieless analytics).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=replace-with-umami-website-id
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.com/script.js

# ── Google OAuth (configured in GoTrue, not read by the app directly) ───────
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# ── WhatsApp Cloud API (Phase 4, M8) ────────────────────────────────────────
WHATSAPP_TOKEN=replace-with-whatsapp-token
WHATSAPP_PHONE_ID=replace-with-phone-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-verify-token
WHATSAPP_APP_SECRET=replace-with-app-secret

# ── Cron ────────────────────────────────────────────────────────────────────
# Guards GET /api/cron/[job]?token=… (expiry/cleanup jobs; all idempotent).
CRON_SECRET=replace-with-cron-secret

# ── Cloudflare Turnstile (waitlist bot protection — dev-plan 0.E) ───────────
# Leave both unset in local dev: the waitlist action skips verification when
# TURNSTILE_SECRET_KEY is absent, and the form renders no widget without the
# site key. When the secret IS set, verification fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
