exports[`<RichText/> (rules.md §6.4 — full block schema) > matches the full-coverage fixture snapshot 1`] = `
"<div class="rt-root"><p data-block-id="fx-p-intro">Aspirin irreversibly inhibits <em>cyclooxygenase</em> via <strong>acetylation</strong>, with H<sub>2</sub>O as a byproduct — see <a class="rt-link" href="https://example.com/cox-pathway">the COX pathway</a><s> for context. Doses are written mg</s> as <code>mg/day</code> (10<sup>3</sup> µg).</p><nav data-block-id="fx-toc" class="rt-toc" aria-label="Contents"><ol><li><a href="#h-fx-h2-pharmacokinetics">Pharmacokinetics</a></li><li class="rt-toc__sub"><a href="#h-fx-h3-monitoring">Monitoring</a></li></ol></nav><h2 id="h-fx-h2-pharmacokinetics" data-block-id="fx-h2-pharmacokinetics">Pharmacokinetics</h2><blockquote data-block-id="fx-blockquote">All things are poison; the dosage alone makes a thing not poison.</blockquote><p data-block-id="fx-p-styled" style="text-align:center;line-height:2">Key fact: <mark class="rt-mark">salicylate toxicity</mark> is dose-dependent. Press <kbd class="rt-kbd">Ctrl</kbd> + <kbd class="rt-kbd">F</kbd> to search. <span style="color:#b91c1c">Red flag</span> terms are <span style="background-color:#fef08a">flagged</span> and <span style="font-size:20px">enlarged</span>. Reviewed <time class="rt-date" dateTime="2026-07-24">Jul 24, 2026</time>.</p><ul class="rt-list" data-block-id="fx-ul-absorption"><li>Rapid gastric absorption</li><li>Wide distribution, <strong>protein-bound</strong><ul class="rt-list"><li>Albumin binding ~90%</li></ul></li></ul><ol class="rt-list" data-block-id="fx-ol-steps"><li>Hydrolysis to salicylate</li><li>Hepatic conjugation</li></ol><hr data-block-id="fx-hr" class="rt-hr"/><details data-block-id="fx-toggle-details" class="rt-toggle"><summary>Advanced: salicylate kinetics</summary><div class="rt-toggle__body"><p data-block-id="fx-toggle-body-p">Zero-order elimination emerges at toxic concentrations.</p><ul class="rt-list" data-block-id="fx-toggle-body-ul"><li>Half-life extends 20h+</li></ul></div></details><div data-block-id="fx-columns" class="rt-columns"><div class="rt-columns__col" style="flex-basis:50%"><p>COX-1: constitutive, gastric protection.</p></div><div class="rt-columns__col" style="flex-basis:50%"><p>COX-2: inducible, inflammation.</p><ul class="rt-list"><li>Selective NSAIDs</li></ul></div></div><h3 id="h-fx-h3-monitoring" data-block-id="fx-h3-monitoring">Monitoring</h3><div data-block-id="fx-table-doses" class="rt-table-wrap"><table class="rt-table"><tbody><tr><th scope="col"><p>Indication</p></th><th scope="col"><p>Dose</p></th></tr><tr><td><p>Antiplatelet</p></td><td><p>75–100 mg daily</p></td></tr><tr><td colSpan="2"><p>Analgesic: 300–900 mg q4–6h</p></td></tr></tbody></table></div><aside data-block-id="fx-callout-definition" class="rt-callout rt-callout--definition"><p class="rt-callout__label">Definition</p><p>Salicylism: the toxidrome of chronic salicylate excess.</p></aside><aside data-block-id="fx-callout-pearl" class="rt-callout rt-callout--clinical_pearl"><p class="rt-callout__label">Clinical Pearl</p><p>Enteric coating delays but does not reduce absorption.</p><p>Chewing non-coated aspirin speeds onset in ACS.</p></aside><aside data-block-id="fx-callout-mnemonic" class="rt-callout rt-callout--mnemonic"><p class="rt-callout__label">Mnemonic</p><p>ASA: Antiplatelet, Salicylism, Asthma caution.</p></aside><aside data-block-id="fx-callout-exam" class="rt-callout rt-callout--exam_alert"><p class="rt-callout__label">Exam Alert</p><p>Reye syndrome association is a recurring exam favorite.</p></aside><aside data-block-id="fx-callout-warning" class="rt-callout rt-callout--warning"><p class="rt-callout__label">Warning</p><p>Avoid in children with viral illness (Reye syndrome).</p></aside><figure data-block-id="fx-img-structure" class="rt-figure"><img src="https://cdn.example.com/content-media/aspirin-structure.webp" alt="Skeletal structure of acetylsalicylic acid" width="1200" height="800" loading="lazy" style="aspect-ratio:1200 / 800"/><figcaption>FIG 1 — Acetylsalicylic acid</figcaption></figure><figure data-block-id="fx-video-mechanism" class="rt-video"><p class="rt-video__placeholder"><a class="rt-link" href="https://www.youtube.com/watch?v=dQw4w9WgXcQ">VIDEO — COX inhibition, step by step</a></p><figcaption>VIDEO — COX inhibition, step by step</figcaption></figure><pre data-block-id="fx-code-calc" data-lang="text" class="rt-code"><code><span class="rt-code__line" data-line="0">loading_dose = Vd × Cp_target
</span><span class="rt-code__line" data-line="1">maintenance = CL × Cp_ss × tau
</span></code></pre><section data-block-id="fx-drugcard-aspirin" class="rt-drugcard"><p class="rt-drugcard__title">Aspirin (acetylsalicylic acid)</p><dl><div class="rt-drugcard__row" data-field="brand_names"><dt>Brand names</dt><dd>Disprin, Ascard</dd></div><div class="rt-drugcard__row" data-field="drug_class"><dt>Class</dt><dd>NSAID (irreversible COX inhibitor)</dd></div><div class="rt-drugcard__row" data-field="mechanism"><dt>Mechanism</dt><dd>Irreversible acetylation of COX-1/COX-2</dd></div><div class="rt-drugcard__row" data-field="indications"><dt>Indications</dt><dd>ACS, secondary CV prevention, pain, fever</dd></div><div class="rt-drugcard__row" data-field="adverse_effects"><dt>Adverse effects</dt><dd>GI bleeding, tinnitus, bronchospasm</dd></div><div class="rt-drugcard__row" data-field="interactions"><dt>Interactions</dt><dd>Warfarin, methotrexate, other NSAIDs</dd></div><div class="rt-drugcard__row" data-field="dosing"><dt>Dosing</dt><dd>75–100 mg daily (antiplatelet)</dd></div><div class="rt-drugcard__row" data-field="notes"><dt>Notes</dt><dd>Stop 7 days before elective surgery.</dd></div></dl></section><div data-block-id="fx-equation-henderson" class="rt-equation"><code>pH = pK_a + \\log_{10}\\frac{[A^-]}{[HA]}</code></div><p data-block-id="fx-p-inline-equation">Clearance follows <span class="rt-inline-equation"><code>CL = k_e \\cdot V_d</code></span> at steady state.</p><p data-block-id="fx-p-outro">Review the monitoring parameters before the next unit.</p></div>"
`;

exports[`<RichText/> (rules.md §6.4 — full block schema) > renders images and videos inside columns via the shared figure path 1`] = `"<div class="rt-root"><h2 id="h-h-top" data-block-id="h-top">Top heading</h2><div data-block-id="cols-media" class="rt-columns"><div class="rt-columns__col" style="flex-basis:50%"><figure class="rt-figure"><img src="https://cdn.example.com/x.webp" alt="Diagram" width="640" height="480" loading="lazy" style="aspect-ratio:640 / 480"/><figcaption>FIG — diagram</figcaption></figure></div><div class="rt-columns__col" style="flex-basis:50%"><figure class="rt-video"><p class="rt-video__placeholder"><a class="rt-link" href="https://youtu.be/dQw4w9WgXcQ">VIDEO — walkthrough</a></p><figcaption>VIDEO — walkthrough</figcaption></figure><h3>Column heading</h3><div class="rt-equation"><code>E = mc^2</code></div><nav class="rt-toc" aria-label="Contents"><ol><li><a href="#h-h-top">Top heading</a></li></ol></nav></div></div></div>"`;
